# TiDB Cloud Starter connection for the multi project.
# Copy this file to .env and replace the placeholders locally.
DATABASE_URL="mysql://<USERNAME>:<PASSWORD>@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/multi_pos?sslaccept=strict"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLIENT_URL="http://localhost:5173"
